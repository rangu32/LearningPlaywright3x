# Copy to .env and fill in real, non-production values.
# Do NOT commit .env (see .gitignore).

BASE_URL=https://app.vwo.com

# Valid account (required for authenticated flows).
VWO_EMAIL=
VWO_PASSWORD=

# Invalid-credential probes (optional; defaults used if empty).
VWO_INVALID_EMAIL=qa.invalid.user@example.com
VWO_INVALID_PASSWORD=__invalid_password__